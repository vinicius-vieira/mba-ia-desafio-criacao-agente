# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Opcional: modelo Gemini usado pelos agentes (padrão: gemini-3.5-flash-lite)
AURORA_MODELO=
# Opcional: diretório dos bancos SQLite (padrão: ./var)
AURORA_DIR_DADOS=
# Opcional: fuso usado para calcular "hoje" e "amanhã" (padrão: America/Sao_Paulo)
AURORA_FUSO_HORARIO=
